/* C library headers must use the implementation-reserved namespace for guards,
 * type plumbing, and implementation extensions so they cannot collide with users.
 */
// NOLINTBEGIN(bugprone-reserved-identifier,cert-dcl37-c,cert-dcl51-cpp)

/* SPDX-FileCopyrightText: (C) 2026 Gavin John
 * SPDX-License-Identifier: GPL-3.0-or-later */

#define _Addr long long
#define _Int64 long long
#define _Reg long long

#define __BYTE_ORDER 1234
/* Unlike arch/x86_64/bits (Windows x86_64, LLP64: `long` stays 32-bit),
 * this arch is a real Linux/LP64 target -- `long` is genuinely 64-bit
 * here, so __LONG_MAX must say so; leaving it at the LLP64 value would
 * silently mis-derive every DSL-generated `long`-typed MIN/MAX pair. */
#define __LONG_MAX 0x7fffffffffffffffL

#ifndef __cplusplus
TYPEDEF unsigned short wchar_t;
#endif
TYPEDEF unsigned wint_t;

TYPEDEF float float_t;
TYPEDEF double double_t;

TYPEDEF struct { long long __ll; long double __ld; } max_align_t;

// NOLINTEND(bugprone-reserved-identifier,cert-dcl37-c,cert-dcl51-cpp)

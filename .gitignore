/config.mak
/obj/
/lib/

# Sanitizer and fuzzer output.  /obj/ already covers obj/asan, obj/fuzzlib
# and obj/fuzz, which is where `make asan` and `make fuzz` put everything;
# these catch corpora or crash artefacts written by hand elsewhere.
/fuzz/corpus/
crash-*
leak-*
timeout-*
oom-*

# Backup copies left by configure re-runs and by patch/merge tools.
*.orig
*.rej

# Scratch output from test/misc.c's exit-flush check.
/misc-exit-flush.tmp

# Fixtures that tests create in the working directory.  `make check` runs
# the test binaries from the source tree, so a test that builds a scratch
# tree leaves it here.  Tests are expected to tear their own fixtures down
# (see ftw_fixture_teardown() in test/posix-glob.c); these entries are the
# backstop for a run that dies before cleanup, so a crashed test cannot
# turn into a committed directory -- or, worse, into a fixture that is
# already present on the next run and makes a test pass for the wrong
# reason.
/root/
/tmp-*/
/test-*.tmp
*.tmp

# Agent worktrees and session state. These are ignored locally on the
# machine this was developed on (a global ignore or .git/info/exclude),
# which is exactly why the omission here went unnoticed -- a fresh clone,
# or anyone else's checkout, would see .claude/worktrees/ as a pile of
# untracked trees. Ignore it in the repo so it does not depend on one
# machine's configuration.
/.claude/

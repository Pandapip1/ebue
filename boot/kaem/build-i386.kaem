${CC} -std=c99 -nostdinc -fno-builtin -D_XOPEN_SOURCE=700 -D_ALL_SOURCE -D_NTLIBC_INTERNAL -I${srcdir}/arch/i386 -I${srcdir}/arch/generic -Iobj/include -I${srcdir}/include -I${srcdir}/src/internal -Wall -Wno-unused-function -MMD -MF obj/src/ctype/islower.d -c -o obj/src/ctype/islower.o ${srcdir}/src/ctype/islower.c
${CC} -std=c99 -nostdinc -fno-builtin -D_XOPEN_SOURCE=700 -D_ALL_SOURCE -D_NTLIBC_INTERNAL -I${srcdir}/arch/i386 -I${srcdir}/arch/generic -Iobj/include -I${srcdir}/include -I${srcdir}/src/internal -Wall -Wno-unused-function -MMD -MF obj/src/ctype/isprint.d -c -o obj/src/ctype/isprint.o ${srcdir}/src/ctype/isprint.c
${CC} -std=c99 -nostdinc -fno-builtin -D_XOPEN_SOURCE=700 -D_ALL_SOURCE -D_NTLIBC_INTERNAL -I${srcdir}/arch/i386 -I${srcdir}/arch/generic -Iobj/include -I${srcdir}/include -I${srcdir}/src/internal -Wall -Wno-unused-function -MMD -MF obj/src/ctype/ispunct.d -c -o obj/src/ctype/ispunct.o ${srcdir}/src/ctype/ispunct.c
${CC} -std=c99 -nostdinc -fno-builtin -D_XOPEN_SOURCE=700 -D_ALL_SOURCE -D_NTLIBC_INTERNAL -I${srcdir}/arch/i386 -I${srcdir}/arch/generic -Iobj/include -I${srcdir}/include -I${srcdir}/src/internal -Wall -Wno-unused-function -MMD -MF obj/src/ctype/isspace.d -c -o obj/src/ctype/isspace.o ${srcdir}/src/ctype/isspace.c

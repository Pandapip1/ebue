${CC} -std=c99 -nostdinc -fno-builtin -D_XOPEN_SOURCE=700 -D_ALL_SOURCE -D_NTLIBC_INTERNAL -I${srcdir}/arch/i386 -I${srcdir}/arch/generic -Iobj/include -I${srcdir}/include -I${srcdir}/src/internal -Wall -Wno-unused-function -MMD -MF obj/src/ctype/iswcntrl.d -c -o obj/src/ctype/iswcntrl.o ${srcdir}/src/ctype/iswcntrl.c

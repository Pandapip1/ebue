x86_64-win32-tcc -std=c99 -nostdinc -fno-builtin -D_XOPEN_SOURCE=700 -D_NTLIBC_INTERNAL -I./arch/x86_64 -I./arch/generic -Iobj/include -I./include -I./src/internal -Wall -Wno-unused-function -MMD -MF obj/src/ctype/isascii.d -c -o obj/src/ctype/isascii.o src/ctype/isascii.c

# This version of config.mak was generated by:
# ./configure --host=x86_64-win32 CC=x86_64-win32-tcc
# Any changes made here will be lost if configure is re-run
AR = x86_64-win32-tcc -ar
ARCH = x86_64
srcdir = .
TARGET = x86_64-win32
prefix = /usr/local/ntlibc
exec_prefix = $(prefix)
bindir = $(exec_prefix)/bin
libdir = $(prefix)/lib
includedir = $(prefix)/include
CC = x86_64-win32-tcc
CFLAGS = 
CFLAGS_AUTO = -Wall -Wno-unused-function
CFLAGS_C99FSE = -std=c99 -nostdinc -fno-builtin
CPPFLAGS = 
LDFLAGS = 
CROSS_COMPILE = 
WINE = /usr/lib/wine/wine64
WRAPPER = yes
KERNEL32 = no
